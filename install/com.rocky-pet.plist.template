<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rocky-pet</string>

  <!-- Point straight at the Electron binary + the app dir, so there's no
       dependency on node / nvm being on launchd's PATH. -->
  <key>ProgramArguments</key>
  <array>
    <string>__PET_DIR__/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron</string>
    <string>__PET_DIR__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PET_DIR__</string>

  <!-- Start at login. No KeepAlive: the × button really quits for the session. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/rocky-pet.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/rocky-pet.err.log</string>
</dict>
</plist>
